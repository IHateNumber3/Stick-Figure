<Application x:Class="StickFigure.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#101318"/>
        <SolidColorBrush x:Key="PanelBackground" Color="#191F27"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#00D4FF"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#8C98A8"/>
    </Application.Resources>
</Application>
